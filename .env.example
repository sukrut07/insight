# ==============================================================================
# iNSIGHT — Multimodal Sign Language Intelligence Platform Configuration
# ==============================================================================

APP_NAME=iNSIGHT
VERSION=2.0.0
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 1. Local AI Orchestrator (Google Gemma 4 E4B via Ollama - Primary / Default)
# ------------------------------------------------------------------------------
# Run locally with:
#   ollama pull gemma4:e4b
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_LLM=gemma4:e4b
FALLBACK_LLM=gemma4:e2b
LLM_TIMEOUT_SECONDS=15.0
DEFAULT_PROVIDER=local_ollama

# ------------------------------------------------------------------------------
# 2. Google Gemini API Configuration (Optional Cloud / Prototyping Mode)
# ------------------------------------------------------------------------------
# Paste your Gemini API key and base URL below.
# When provided and CLOUD_CONSENT_GRANTED=true, iNSIGHT can optionally utilize
# hosted Gemma/Gemini multimodal models for high-throughput evaluation.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_GEMMA_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it
CLOUD_CONSENT_GRANTED=false

# ------------------------------------------------------------------------------
# 3. Speech Engine & Audio Output
# ------------------------------------------------------------------------------
DEFAULT_SPEECH_RATE=175
DEFAULT_VOICE=Samantha
