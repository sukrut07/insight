# ==============================================================================
# iNSIGHT — Multimodal Sign Language Intelligence Platform Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=iNSIGHT
VERSION=2.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Local AI Orchestrator (Google Gemma 4 E4B via Ollama - Primary / Default)
# ------------------------------------------------------------------------------
# Run locally with:
#   ollama pull gemma4:e4b
#   ollama pull gemma4:e2b
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODEL=gemma4:e2b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=30.0

# Backwards-compatible aliases
PRIMARY_LLM=gemma4:e4b
FALLBACK_LLM=gemma4:e2b
LLM_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 3. Google Gemini API Configuration (Optional Cloud / Prototyping Mode)
# ------------------------------------------------------------------------------
# Obtain API key from Google AI Studio (https://aistudio.google.com/apikey).
# Cloud inference is DISABLED by default to protect user privacy.
# Live webcam frames are NEVER transmitted to cloud endpoints unless
# CLOUD_CONSENT_GRANTED=true is explicitly set.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_GEMMA_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it
GEMINI_ENABLED=false
CLOUD_CONSENT_GRANTED=false

# ------------------------------------------------------------------------------
# 4. Hugging Face Hub & Model Caching
# ------------------------------------------------------------------------------
# Optional token for gated models (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_HOME=./models/huggingface
HF_OFFLINE=false

# ------------------------------------------------------------------------------
# 5. Model Routing & Verification Telemetry
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=local_ollama
ENABLE_CLOUD_FALLBACK=false
ENABLE_MULTIMODAL_VERIFICATION=true
ENABLE_MODEL_USAGE_TRACKING=true

# ------------------------------------------------------------------------------
# 6. Recognition Pipeline Parameters
# ------------------------------------------------------------------------------
DEFAULT_LANGUAGE=isl
RECOGNITION_CONFIDENCE_THRESHOLD=0.60
TEMPORAL_WINDOW_SIZE=30

# ------------------------------------------------------------------------------
# 7. Voice Enablement (TTS Output & STT Voice Input)
# ------------------------------------------------------------------------------
VOICE_ENABLED=true
TTS_PROVIDER=browser
STT_ENABLED=true
SPEECH_LANGUAGE=en-IN
DEFAULT_SPEECH_RATE=175
DEFAULT_VOICE=Samantha

# ------------------------------------------------------------------------------
# 8. DigitalOcean Deployment Metadata (Optional)
# ------------------------------------------------------------------------------
DO_API_TOKEN=
DO_APP_ID=
