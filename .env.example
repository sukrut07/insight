# ==============================================================================
# iNSIGHT — Multimodal Sign Language Intelligence Platform Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite on Vercel)
# ------------------------------------------------------------------------------
# Leave empty if backend is co-located or using Vercel rewrites (/api).
# For separate backend (e.g., Railway, Render, Fly.io, or VPS), set:
# Example: https://insight-backend.railway.app
VITE_API_URL=

# WebSocket server for real-time recognition streaming.
# Note: Vercel serverless functions do NOT support persistent WebSockets.
# Host the WebSocket inference server on a persistent runtime (Render, Railway, Fly.io, or local).
# Example: wss://insight-backend.railway.app
VITE_WS_URL=

# ------------------------------------------------------------------------------
# 2. Application & Runtime Settings
# ------------------------------------------------------------------------------
APP_ENV=production
APP_NAME=iNSIGHT
VERSION=2.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional Vercel Large Functions Beta flag:
# Setting VERCEL_SUPPORT_LARGE_FUNCTIONS=1 allows serverless Python packages up to 5 GB.
# (Recommended: Keep dependencies lean with backend/requirements-api.txt instead).
VERCEL_SUPPORT_LARGE_FUNCTIONS=0

# ------------------------------------------------------------------------------
# 3. Google Gemini API Cloud Provider (Server-Side ONLY)
# ------------------------------------------------------------------------------
# CRITICAL: Never prefix GEMINI_API_KEY with VITE_. It must remain server-side.
# Obtain API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GEMMA_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_ENABLED=true
CLOUD_CONSENT_GRANTED=true

# ------------------------------------------------------------------------------
# 4. Local / External Ollama AI Service (Gemma 4 Orchestrator)
# ------------------------------------------------------------------------------
# If running Ollama on an external machine or cloud VPS:
# Example: http://ollama-host:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODEL=gemma4:e2b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=30.0

PRIMARY_LLM=gemma4:e4b
FALLBACK_LLM=gemma4:e2b
LLM_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. AI Model Routing & Telemetry
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=gemini
ENABLE_CLOUD_FALLBACK=true
ENABLE_MULTIMODAL_VERIFICATION=true
ENABLE_MODEL_USAGE_TRACKING=true

# ------------------------------------------------------------------------------
# 6. Recognition Pipeline Parameters
# ------------------------------------------------------------------------------
DEFAULT_LANGUAGE=isl
RECOGNITION_CONFIDENCE_THRESHOLD=0.60
TEMPORAL_WINDOW_SIZE=30

# ------------------------------------------------------------------------------
# 7. Voice Enablement (TTS Output & STT Voice Input)
# ------------------------------------------------------------------------------
VOICE_ENABLED=true
TTS_PROVIDER=browser
STT_ENABLED=true
SPEECH_LANGUAGE=en-IN
DEFAULT_SPEECH_RATE=175
DEFAULT_VOICE=Samantha
